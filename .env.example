# ==============================================================================
# DOGFOOD PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://dogfood:dogfood_secret@localhost:5432/dogfood"

# Authentication Secrets
JWT_SECRET="dogfood-dev-secret-change-in-production"
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# THIRD-PARTY EMAIL SERVICES (Choose Resend, SendGrid, or standard SMTP)
# ------------------------------------------------------------------------------
# Option A: Resend (Modern, recommended for Vercel/Next.js)
# RESEND_API_KEY="re_123456789abcdef"

# Option B: SendGrid
# SENDGRID_API_KEY="SG.123456789abcdef"

# Option C: Standard SMTP (Gmail, AWS SES, Postmark, Mailgun)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="DOGFOOD Platform <noreply@yourdomain.com>"

# (Note: If no email service is configured, DOGFOOD automatically logs OTP codes
# to the server console and provides auto-fill helpers in development mode).

# ------------------------------------------------------------------------------
# SOCIAL OAUTH PROVIDERS (Google, GitHub, Discord)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (From Google Cloud Console: APIs & Services > Credentials)
# Callback URL: http://localhost:3000/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID="123456789-abcdef.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# GitHub OAuth App (From GitHub Settings > Developer settings > OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID="Iv1.your-client-id"
# GITHUB_CLIENT_SECRET="your-github-secret"

# Discord OAuth2 (From Discord Developer Portal > Applications > OAuth2)
# Callback URL: http://localhost:3000/api/auth/oauth/discord/callback
# DISCORD_CLIENT_ID="123456789012345678"
# DISCORD_CLIENT_SECRET="your-discord-secret"

# (Note: If OAuth credentials are not set, development mode automatically enables
# a local mock OAuth simulator so you can test Google, GitHub, and Discord 1-click logins).
