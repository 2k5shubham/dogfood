// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS & AUTH ────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  displayName  String   @map("display_name")
  bio          String?
  avatarUrl    String?  @map("avatar_url")
  globalRole   String   @default("user") @map("global_role") // "user" | "admin"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions       Session[]
  eventRoles     EventRole[]
  teamMemberships TeamMember[]
  teamsCreated   Team[]
  projects       Project[]      @relation("ProjectOwner")
  judgeScores    JudgeScore[]
  judgeAssignments JudgeAssignment[]
  comments       Comment[]
  auditLogs      AuditLog[]
  eventsOrganized Event[]
  userVotes      UserVote[]
  oauthAccounts  OAuthAccount[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── EVENTS ──────────────────────────────────────────────────────────────────

model Event {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  description         String
  organizerId         String    @map("organizer_id")
  registrationOpensAt DateTime? @map("registration_opens_at")
  submissionOpensAt   DateTime? @map("submission_opens_at")
  submissionDeadline  DateTime  @map("submission_deadline")
  votingOpensAt       DateTime? @map("voting_opens_at")
  votingDeadline      DateTime? @map("voting_deadline")
  resultsPublishedAt  DateTime? @map("results_published_at")
  bannerUrl           String?   @map("banner_url")
  status              String    @default("draft") // draft | registration | active | judging | voting | closed
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organizer        User              @relation(fields: [organizerId], references: [id])
  tracks           Track[]
  eventRoles       EventRole[]
  teams            Team[]
  projects         Project[]
  rubricCriteria   RubricCriterion[]
  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]
  normalizationRuns NormalizationRun[]
  scoreCache       ScoreCache[]
  userVotes        UserVote[]
  auditLogs        AuditLog[]

  @@map("events")
}

model Track {
  id            String  @id @default(cuid())
  eventId       String  @map("event_id")
  name          String
  description   String?
  prizeAmount   Float?  @map("prize_amount")
  prizeCurrency String? @default("USD") @map("prize_currency")
  order         Int     @default(0)

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("tracks")
}

// ─── ROLES (per-event) ───────────────────────────────────────────────────────

model EventRole {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  eventId    String    @map("event_id")
  role       String    // organizer | judge | participant
  invitedBy  String?   @map("invited_by")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("event_roles")
}

// ─── TEAMS ───────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  name        String
  bio         String?
  inviteCode  String   @unique @map("invite_code")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  creator  User         @relation(fields: [createdById], references: [id])
  members  TeamMember[]
  projects Project[]

  @@unique([eventId, name])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     String   @default("member") // lead | member
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ─── PROJECTS ────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(cuid())
  teamId      String    @map("team_id")
  eventId     String    @map("event_id")
  trackId     String?   @map("track_id")
  ownerId     String    @map("owner_id")
  title       String
  tagline     String?
  description String
  repoUrl     String?   @map("repo_url")
  demoUrl     String?   @map("demo_url")
  videoUrl    String?   @map("video_url")
  coverUrl    String?   @map("cover_url")
  repoHash    String?   @map("repo_hash") // SHA-1 of repoUrl for duplicate detection
  status      String    @default("draft") // draft | submitted | disqualified
  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  team             Team              @relation(fields: [teamId], references: [id])
  event            Event             @relation(fields: [eventId], references: [id])
  track            Track?            @relation(fields: [trackId], references: [id])
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  judgeAssignments JudgeAssignment[]
  judgeScores      JudgeScore[]
  scoreCache       ScoreCache[]
  userVotes        UserVote[]
  comments         Comment[]

  @@unique([teamId, eventId])
  @@map("projects")
}

// ─── JUDGING ENGINE ──────────────────────────────────────────────────────────

model RubricCriterion {
  id          String  @id @default(cuid())
  eventId     String  @map("event_id")
  name        String
  description String?
  weight      Float   // must sum to 1.0 per event (enforced in app layer)
  maxScore    Float   @default(5) @map("max_score")
  order       Int     @default(0)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeScores JudgeScore[]

  @@map("rubric_criteria")
}

model JudgeAssignment {
  id          String    @id @default(cuid())
  judgeId     String    @map("judge_id")
  projectId   String    @map("project_id")
  eventId     String    @map("event_id")
  assignedBy  String    @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  completedAt DateTime? @map("completed_at")

  judge   User    @relation(fields: [judgeId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([judgeId, projectId])
  @@map("judge_assignments")
}

model JudgeScore {
  id          String   @id @default(cuid())
  judgeId     String   @map("judge_id")
  projectId   String   @map("project_id")
  criterionId String   @map("criterion_id")
  eventId     String   @map("event_id")
  score       Float
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 🔒 These relations are ALWAYS queried with judgeId filter in DAL
  judge     User            @relation(fields: [judgeId], references: [id])
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id])
  event     Event           @relation(fields: [eventId], references: [id])

  @@unique([judgeId, projectId, criterionId])
  @@map("judge_scores")
}

model ScoreCache {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  projectId       String   @map("project_id")
  rawWeightedAvg  Float?   @map("raw_weighted_avg")
  normalizedScore Float?   @map("normalized_score")
  judgeCount      Int      @default(0) @map("judge_count")
  computedAt      DateTime @map("computed_at")

  event   Event   @relation(fields: [eventId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([eventId, projectId])
  @@map("score_cache")
}

model NormalizationRun {
  id                   String   @id @default(cuid())
  eventId              String   @map("event_id")
  method               String   @default("z-score")
  parametersJson       Json     @map("parameters_json")
  runBy                String   @map("run_by")
  runAt                DateTime @default(now()) @map("run_at")
  affectedProjectCount Int      @map("affected_project_count")

  event Event @relation(fields: [eventId], references: [id])

  @@map("normalization_runs")
}

// ─── COMMUNITY VOTING (T3) ───────────────────────────────────────────────────
// Account-bound voting: one upvote per registered user per project.
// Sybil resistance: each vote is tied to a unique registered account (unique email
// enforced at DB level). Duplicate votes are blocked by UNIQUE(userId, projectId).
// Accounts created after submission deadline cannot vote (account-age check in API).

model UserVote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  eventId   String   @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])     // DB-enforced: one vote per user per project
  @@index([eventId, projectId])     // fast aggregate counts
  @@index([userId, eventId])        // fast "my votes" lookup
  @@map("user_votes")
}

// ─── COMMENTS ────────────────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("comments")
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  action       String   // SCORE_SUBMIT, ROLE_ASSIGNED, PROJECT_SUBMIT, VOTE_CAST, etc.
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  oldValueJson Json?    @map("old_value_json")
  newValueJson Json?    @map("new_value_json")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  eventId      String?  @map("event_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([entityType, entityId])
  @@index([eventId, action])
  @@map("audit_log")
}

// ─── EMAIL OTP AUTHENTICATION ───────────────────────────────────────────────

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   @map("code_hash")
  purpose   String   @default("REGISTER") // "REGISTER" | "PASSWORD_RESET"
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_otps")
}

// ─── OAUTH SOCIAL SIGN-IN (GOOGLE, GITHUB, DISCORD) ─────────────────────────

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String   // "google" | "github" | "discord"
  providerUserId String   @map("provider_user_id")
  email          String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}


